  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "bugs": {
    "url": "https://github.com/Zemetric/design-system/issues"
  },
  "homepage": "https://github.com/Zemetric/design-system#readme"
}
